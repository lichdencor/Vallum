{:paths ["src"]
 :deps  {org.clojure/clojure         {:mvn/version "1.12.0"}
         org.clojure/tools.namespace {:mvn/version "1.5.0"}
         org.clojure/test.check      {:mvn/version "1.1.1"}
         org.clojure/spec.alpha      {:mvn/version "0.3.218"}
         cheshire/cheshire           {:mvn/version "5.13.0"}}

 :aliases
 {:repl {:extra-paths ["dev" "test"]
         :extra-deps  {com.bhauman/rebel-readline-clojure {:mvn/version "0.1.4"}}
         :main-opts   ["-m" "rebel-readline.main"]}

  :test {:extra-paths ["test"]
         :main-opts   ["-m" "vallum.run-all"]}

  :kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
          :main-opts    ["-m" "clj-kondo.main"]}

  :fmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
        :main-opts    ["-m" "cljfmt.main"]}

  :harness {:extra-paths ["test"]
            :main-opts   ["-m" "vallum.harness"]}

  :native {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]}}}
